rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/changes/{changeId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      // Clients may remove entry contents, never the deletion or settings records other devices rely on.
      allow delete: if request.auth != null && request.auth.uid == userId
        && (resource == null || ('entry' in resource.data && resource.data.get('deleted', false) != true));
      allow update: if false;
    }
  }
}
